# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=your_password

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_bucket_name

# OpenSearch Content Search
OPENSEARCH_AUTH_MODE=aws
OPENSEARCH_ENDPOINT=https://vpc-openpecha-content-search-dev.example.ap-southeast-1.es.amazonaws.com
OPENSEARCH_INDEX=content-search
OPENSEARCH_CATALOG_INDEX=catalog-search
OPENSEARCH_TIBETAN_PLUGIN_ZIP=/absolute/path/to/analysis-tibetan.zip
OPENSEARCH_BDRC_PLUGIN_ZIP=/absolute/path/to/analysis-bdrc.zip

# Environment
ENVIRONMENT=dev

# OpenTelemetry / Grafana Cloud (optional - set OTEL_ENABLED=true to activate)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=openpecha-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-southeast-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded instanceId:cloud-api-token>
